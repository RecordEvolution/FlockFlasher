{
  "name": "flockflasher",
  "version": "2.2.0",
  "description": "An efficient, modern and reliable flashing tool for IoT applications",
  "author": "Record Evolution GmbH",
  "publisher": "Record Evolution GmbH",
  "main": "./out/main/index.js",
  "license": "MIT",
  "homepage": "https://www.electronjs.org",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "electron-vite preview",
    "postinstall": "node scripts/windows.js && node scripts/fetch-node.js && electron-builder install-app-deps && node scripts/rebuild-flash-natives.js",
    "dev": "electron-vite dev",
    "dev:debug": "electron-vite dev --inspect",
    "release": "electron-builder",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && electron-builder --win --config",
    "build:macm1": "npm run build && electron-builder --mac --config",
    "build:linux": "npm run build && electron-builder --linux --config"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@mdi/font": "^7.4.47",
    "@mdi/js": "^7.4.47",
    "ansi-to-html": "^0.7.2",
    "drivelist": "^12.0.2",
    "echarts": "^5.6.0",
    "electron-log": "^5.4.0",
    "electron-updater": "^6.8.9",
    "etcher-sdk": "^10.2.13",
    "fix-path": "^3.0.0",
    "humanize-duration": "^3.33.0",
    "lodash": "^4.17.21",
    "mountutils": "^2.0.5",
    "node-powershell": "^5.0.1",
    "node-wifi": "^2.0.16",
    "path-browserify": "^1.0.1",
    "pinia": "^3.0.4",
    "pretty-bytes": "^6.1.1",
    "roboto-fontface": "^0.10.0",
    "semver": "^7.7.2",
    "uuid": "^9.0.1",
    "vue-composable": "^1.0.0-beta.24",
    "vue-i18n": "^9.14.5",
    "vuetify": "^3.12.9"
  },
  "optionalDependencies": {
    "winusb-driver-generator": "^2.1.10"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^2.1.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/notarize": "^3.1.1",
    "@electron/rebuild": "^4.2.0",
    "@swc/core": "^1.15.43",
    "@types/lodash": "^4.17.20",
    "@types/node": "^22.20.1",
    "@types/node-wifi": "^2.0.2",
    "@types/path-browserify": "^1.0.2",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "electron-devtools-installer": "^4.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.9.2",
    "less": "^4.6.7",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.10",
    "vue": "^3.5.39",
    "vue-tsc": "^3.3.7"
  },
  "engines": {
    "node": ">=20.19.0 <25"
  },
  "overrides": {
    "axios": "^1.12.0",
    "tar-fs@^2.0.0": "^2.1.3",
    "tar-fs@^1.16.0": "^1.16.5"
  }
}
