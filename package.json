{
  "name": "flockflasher",
  "version": "2.1.0",
  "description": "An efficient, modern and reliable flashing tool for IoT applications",
  "author": "Record Evolution GmbH",
  "publisher": "Record Evolution GmbH",
  "main": "./out/main/index.js",
  "license": "MIT",
  "homepage": "https://www.ironflock.com",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts,.vue --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "postinstall": "node scripts/windows.js && electron-builder install-app-deps",
    "dev": "electron-vite dev",
    "release": "electron-builder",
    "build": "npm run typecheck && electron-vite build",
    "build:win": "npm run build && electron-builder --win --config",
    "build:mac": "npm run build && electron-builder --mac --config --x64",
    "build:macm1": "npm run build && electron-builder --mac --config",
    "build:linux": "npm run build && electron-builder --linux --config"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@mdi/font": "^7.4.47",
    "@mdi/js": "^7.4.47",
    "ansi-to-html": "^0.7.2",
    "drivelist": "^12.0.2",
    "echarts": "^5.5.1",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9",
    "etcher-sdk": "^9.1.2",
    "fix-path": "^3.0.0",
    "humanize-duration": "^3.32.1",
    "lodash": "^4.17.21",
    "node-fetch": "^2.7.0",
    "node-powershell": "^5.0.1",
    "node-wifi": "^2.0.16",
    "path-browserify": "^1.0.1",
    "pinia": "^2.2.4",
    "pretty-bytes": "^6.1.1",
    "roboto-fontface": "^0.10.0",
    "semver": "^7.6.3",
    "sudo-prompt": "^9.2.1",
    "terminate": "^2.8.0",
    "uuid": "^10.0.0",
    "vue-composable": "^1.0.0-beta.24",
    "vue-echarts": "^7.0.3",
    "vue-i18n": "^10.0.4",
    "vue-svg-gauge": "^1.2.1",
    "vuetify": "^3.7.3"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^1.0.2",
    "@electron-toolkit/eslint-config-ts": "^2.0.0",
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@electron/notarize": "2.5.0",
    "@electron/rebuild": "^3.7.0",
    "@rushstack/eslint-patch": "^1.10.4",
    "@types/lodash": "^4.17.12",
    "@types/node": "^22.7.8",
    "@types/node-fetch": "^2.6.11",
    "@types/node-wifi": "^2.0.2",
    "@types/path-browserify": "^1.0.3",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-vue": "^5.1.4",
    "@vue/eslint-config-prettier": "^10.0.0",
    "@vue/eslint-config-typescript": "^14.1.2",
    "electron": "^26.0.2",
    "electron-builder": "^25.1.8",
    "electron-devtools-installer": "^3.2.0",
    "electron-vite": "^2.3.0",
    "eslint": "^9.13.0",
    "eslint-plugin-vue": "^9.29.1",
    "less": "^4.2.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.9",
    "vue": "^3.5.12",
    "vue-tsc": "^2.1.6"
  },
  "engines": {
    "node": ">=18 <19"
  }
}
